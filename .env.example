VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_VAPID_PUBLIC_KEY=
VITE_SENTRY_DSN=

# Server-side only. Set as Supabase Edge Function secrets in deployed environments.
# Gemini handles user-facing multimodal extraction. DeepSeek is restricted to
# non-personal catalogue enrichment. OpenAI is an off-by-default emergency fallback.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
AI_OPENAI_FALLBACK_ENABLED=false
# Pricing provider base URL or full /basket/compare endpoint. Never expose these as VITE_ variables.
PRICING_API_URL=
PRICING_API_KEY=
# Optional provider-specific authentication, e.g. x-api-key with an empty prefix.
PRICING_API_KEY_HEADER=Authorization
PRICING_API_KEY_PREFIX=Bearer
ALLOWED_ORIGINS=http://localhost:8080
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com
